# You can find documentation for all the supported env variables at https://docs.immich.app/install/environment-variables
# This environment based on example @ https://github.com/immich-app/immich/blob/main/docker/example.env 

# The location where user's uploaded photos and clips are stored
UPLOAD_LOCATION=/media/RAID/Camera/Photos

# The location where database, configuration, and external library files are stored. Network shares are not supported for the database
DB_DATA_LOCATION=/DATA/AppData/immich
APPDATA_LOCATION=/DATA/AppData/immich
EXTLIB_LOCATION=/media/RAID/Camera/Albums

# To set a timezone, uncomment the next line and change Etc/UTC to a TZ identifier from this list: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones#List
# TZ=America/Chicago

# The Immich and michine-learning version to use. Pin this to a specific version like "v3.3.1" or "release" (avoid latest)
IMMICH_VERSION=v3.3.1
MACHINE_LEARNING_VERSION=v3.3.1
REDIS_VERSION=9@sha256:c123e3715db63d06d4ad6964884037aa0d5d4d703939b9929954112889708e1d
POSTGRES_VERSION=14-vectorchord0.4.3-pgvectors0.2.0@sha256:bcf63357191b76a916ae5eb93464d65c07511da41e3bf7a8416db519b40b1c23

# HDD when DB_DATA_LOCATION is on mechanical Hard-Disk-Drive (sequential-IO). SSD for solid-state (concurrent-IO) 
DB_STORAGE_TYPE=HDD

# Hardware acceleration values: -armnn (Mali), -cuda (nVIDIA-GPU), -rocm (AMD-GPU) , -openvino (Intel-GPU) -rknn (Rockchip), or empty is no external GPU.
# More @ https://docs.immich.app/features/ml-hardware-acceleration
HARDWARE_ACCELERATION=

# Connection secret for postgres. You should change it to a random password
# Please use only the characters `A-Za-z0-9`, without special characters or spaces
DB_PASSWORD=secRET-P0Stgres

# The values below this line do not need to be changed
###################################################################################
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
